# Vercel side — copy to app/builder/.env, never commit real values.
# Only VITE_* vars reach the browser bundle. Everything else is server-only
# (readable by the edge routes under app/builder/api/).

# --- Browser-exposed (safe) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_PUBLISH_PIPELINE_URL=/api/publish
VITE_ASSET_PIPELINE_URL=/api/assets

# --- Server-only (api/ routes) ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...     # legacy service_role JWT
CRON_SECRET=same-value-as-supabase-secret
