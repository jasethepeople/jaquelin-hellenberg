<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.8">
  <resources>
    <format id="r1" name="FFVideoFormat1080p30" frameDuration="100/3000s"/>
    <asset id="a1" name="Source" src="file://podcast.mp4" />
  </resources>
  <library>
    <event name="AI_Clip_Project">
      <project name="Generated Clips">
        <sequence format="r1">
          <spine>
            <asset-clip ref="a1" offset="0s" name="insightful" start="10.5s" duration="34.5s" />
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>